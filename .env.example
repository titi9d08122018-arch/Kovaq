# =====================================================================
# Kovaq Retail Analytics — plantilla de variables de entorno
# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env al repositorio (ya está en .gitignore).
# =====================================================================

# --- Modo de ejecución ---
# local = procesa la cámara con YOLO en esta máquina
# nube  = solo sirve la web (Render); no carga YOLO ni la cámara
MODO=local

# --- Seguridad (OBLIGATORIO) ---
# Mínimo 32 caracteres. Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# Duración de la sesión en minutos (por defecto 480 = 8 horas)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Admin inicial ---
# Solo se usa si la base de datos no tiene usuarios.
# La contraseña debe tener al menos 12 caracteres.
KOVAQ_ADMIN_USER=
KOVAQ_ADMIN_PASSWORD=

# --- Base de datos ---
# Si TURSO_URL está vacío se usa SQLite local (DB_LOCAL)
TURSO_URL=
TURSO_TOKEN=
DB_LOCAL=kovaq_local.db

# --- Chat de IA (Groq) ---
GROQ_API_KEY=

# --- Video en vivo local -> nube ---
# Mismo valor en la PC local y en Render
VIDEO_PUSH_TOKEN=
# Solo en la PC local: URL del endpoint de la nube, p. ej. https://TU-APP.onrender.com/api/frame_push
PUBLICAR_VIDEO_URL=

# --- Cámara y modelo YOLO (solo MODO=local) ---
# Número de dispositivo USB (0) o URL rtsp://usuario:clave@ip:554/ruta
RTSP_URL=0
YOLO_IMGSZ=320
YOLO_CONF=0.28
YOLO_INTERVALO=0.08
